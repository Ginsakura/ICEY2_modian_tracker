#!/usr/bin/env bash

# 遇到未定义变量报错并退出
set -u

# 切换到脚本所在绝对目录，保证相对路径正确
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1

PID_FILE="$SCRIPT_DIR/run.pid"
PYTHON_BIN="${PYTHON_BIN:-python}"
ACTION="${1:-start}"

# 检查并激活虚拟环境（Linux/Termux 下路径为 .venv/bin/activate）
VENV_ACTIVATE="$SCRIPT_DIR/.venv/bin/activate"
if [ -f "$VENV_ACTIVATE" ]; then
    # shellcheck disable=SC1090
    source "$VENV_ACTIVATE"
else
    echo "警告: 未找到虚拟环境激活脚本: $VENV_ACTIVATE" >&2
fi

LOG_DIR="$SCRIPT_DIR/logs"
mkdir -p "$LOG_DIR"
OUT_LOG="$LOG_DIR/launcher.out.log"
ERR_LOG="$LOG_DIR/launcher.err.log"

read_pid() {
    # 兼容 PowerShell Out-File 留下的 UTF-8 BOM 与 CRLF
    tr -d '\r\357\273\277[:space:]' < "$PID_FILE" 2>/dev/null || true
}

get_status() {
    STATUS="stopped"
    PID=""
    if [ -f "$PID_FILE" ]; then
        PID="$(read_pid)"
        if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
            STATUS="running"
        else
            STATUS="dead"
        fi
    fi
}

wait_for_pid() {
    local launcher_pid="$1" i pid
    for i in $(seq 1 60); do
        if [ -f "$PID_FILE" ]; then
            pid="$(read_pid)"
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                PID="$pid"
                return 0
            fi
        fi
        if ! kill -0 "$launcher_pid" 2>/dev/null; then
            return 1
        fi
        sleep 0.25
    done
    return 1
}

start() {
    get_status
    if [ "$STATUS" = "running" ]; then
        echo "服务已在运行中 (PID: $PID)"
        return 1
    fi

    if [ "$STATUS" = "dead" ]; then
        rm -f "$PID_FILE" 2>/dev/null || true
    fi

    # Python 自行写 run.pid；启动器只负责拉起并等待 PID 出现
    nohup "$PYTHON_BIN" modian_tracker.py > "$OUT_LOG" 2> "$ERR_LOG" &
    local launcher_pid=$!

    if wait_for_pid "$launcher_pid"; then
        echo "已在后台启动抓取进程 (PID: $PID)。"
        echo "抓取间隔与项目见: $SCRIPT_DIR/trackers.json"
        echo "抓取日志: $SCRIPT_DIR/tracker_log.log"
        echo "启动器日志: $OUT_LOG / $ERR_LOG"
        echo "PID 文件: $PID_FILE"
        return 0
    fi

    echo "启动失败：未等到 run.pid 或进程提前退出。" >&2
    if [ -s "$ERR_LOG" ]; then
        echo "--- 启动器错误日志（末尾）---" >&2
        tail -n 20 "$ERR_LOG" >&2 || true
    fi
    return 1
}

state() {
    get_status
    if [ "$STATUS" = "running" ]; then
        echo "服务运行中 (PID: $PID)"
    elif [ "$STATUS" = "dead" ]; then
        echo "服务已死亡 (PID 文件存在但进程不存在: $PID)"
    else
        echo "服务已停止"
    fi
}

stop() {
    get_status
    if [ "$STATUS" != "running" ]; then
        echo "服务未在运行"
        rm -f "$PID_FILE" 2>/dev/null || true
        return 0
    fi

    echo "正在停止服务 (PID: $PID)..."
    kill "$PID" 2>/dev/null || true

    local i
    for i in $(seq 1 30); do
        if ! kill -0 "$PID" 2>/dev/null; then
            echo "服务已停止"
            rm -f "$PID_FILE" 2>/dev/null || true
            return 0
        fi
        sleep 1
    done

    echo "强制杀死进程..."
    kill -9 "$PID" 2>/dev/null || true
    rm -f "$PID_FILE" 2>/dev/null || true
    echo "服务已强制停止"
}

restart() {
    stop
    sleep 1
    start
}

case "$ACTION" in
    start) start ;;
    stop) stop ;;
    restart) restart ;;
    state|status) state ;;
    *)
        echo "用法: $0 {start|stop|restart|state|status}"
        echo "示例:"
        echo "  $0              # 启动服务"
        echo "  $0 start        # 启动服务"
        echo "  $0 stop         # 停止服务"
        echo "  $0 restart      # 重启服务"
        echo "  $0 state        # 查看运行状态"
        exit 1
        ;;
esac
